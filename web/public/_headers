# Cloudflare Pages. Only thebiasindex.com is canonical: the *.pages.dev copies (production and previews) are not indexed.
https://:project.pages.dev/*
	X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
	X-Robots-Tag: noindex, nofollow

# Everything is public and static, so any site or tool may read it (the JSON and llms.txt are meant for that).
# Pages' _headers has no suffix patterns, so this covers every path.
/*
	Access-Control-Allow-Origin: *
