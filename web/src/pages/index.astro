    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #e6e3ec;
    padding-top: 12px;
    font-size: 13px;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  // Equal gaps between the three facts, the last one ending at the right edge, whatever the width of each number.
  // Each fact is right-aligned; inkEnd() puts the last stroke of the number and of its label on the same line.
