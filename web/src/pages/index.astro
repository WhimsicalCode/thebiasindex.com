---
import mountain from "@/assets/images/land-mountain.jpg"
// Home page (design/v2/mockups/Main.dc.html), desktop and phone in one layout.
import FairTable from "@/components/fair-table.astro"
import FlagBar from "@/components/flag-bar.astro"
import QuestionLegend from "@/components/question-legend.astro"
import ScatterChart from "@/components/scatter-chart.astro"
import BaseLayout from "@/layouts/base-layout.astro"
import {
  byRedFlags,
  companies,
  companyHref,
  examplePage,
  latestRun,
  longDate,
  QUESTIONS,
  scoredCompanies,
} from "@/lib/db"
import { href } from "@/lib/deploy"
import { fmt, perPage, redFlags } from "@/lib/format"
import { siteDataset } from "@/lib/schema"
import { REPO_URL, WHY_URL } from "@/lib/site"

const all = companies()
const ranked = byRedFlags(all)
const top = ranked.slice(0, 10)
const scale = ranked[0]?.biasLoad ?? 1
const example = examplePage(all)
const run = latestRun()
const totalPages = all.reduce((sum, c) => sum + c.scoredPages, 0)
const totalFlags = all.reduce((sum, c) => sum + c.biasLoad, 0)
const urlOf = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "")

// For the lookup: every domain a company is known by, pointing at its page.
const domains = Object.fromEntries(
  all.flatMap(c =>
    [c.slug, ...c.aliases, ...c.hosts].map(domain => [domain.replace(/^www\./, ""), companyHref(c)])
  )
)
---

<BaseLayout
  title="How fair are SaaS comparison pages? · The Bias Index"
  home
  alternates={[{ href: href("/companies.json"), type: "application/json", title: "Every company, as JSON" }]}
  jsonLd={siteDataset()}
>
  <main>
    <section class="wrap hero">
      <div class="hero-cols">
        <div>
          <p class="kicker muted">Read every week.{run && ` Last updated ${longDate(run.startedAt)}.`}</p>
          <h1 class="display h1">How fair are SaaS comparison pages?</h1>
          <p class="lede">
            On their own comparison pages, companies win every single time. Every week, we find them all and score
            each one for bias.
          </p>
        </div>

        <div class="hero-right" id="questions">
          {
            example && (
              <figure class="example">
                <figcaption class="example-k">A biased compare page</figcaption>
                <a class="example-url" href={example.url} rel="nofollow noopener">{urlOf(example.url)}</a>
                <ul>
                  {QUESTIONS.map((q, i) => (
                    <li>
                      <i class:list={["dot", { off: example.answers[i] !== "flag" }]} style={`background: ${q.color}`} />
                      <span>{q.label}</span>
                      <b>{example.answers[i] === "flag" ? "Flagged" : "Not flagged"}</b>
                    </li>
                  ))}
                </ul>
                <div class="example-total">
                  <span>{redFlags(example.score ?? 0)} out of {QUESTIONS.length}</span>
                  <span class="dots" aria-hidden="true">
                    {QUESTIONS.map((q, i) => (
                      <i class:list={["dot", { off: example.answers[i] !== "flag" }]} style={`background: ${q.color}`} />
                    ))}
                  </span>
                </div>
              </figure>
            )
          }
          <form class="lookup" action={href("/companies")} data-domains={JSON.stringify(domains)}>
            <label for="domain">Look up a company by its website</label>
            <div class="lookup-row">
              <input
                id="domain"
                name="q"
                type="text"
                placeholder="miro.com"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                inputmode="url"
              />
              <button class="btn" type="submit">Look up</button>
            </div>
            <p class="lookup-note" role="status" hidden></p>
          </form>
        </div>
      </div>

      <div class="facts">
        <div class="fact"><b>{fmt(all.length)}</b><span>Companies</span></div>
        <div class="fact"><b>{fmt(totalPages)}</b><span>Compare pages</span></div>
        <div class="fact"><b>{fmt(totalFlags)}</b><span>Red flags</span></div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <h2 class="display h2">Most red flags</h2>
        <p>Every red flag on every page, added up.</p>
      </div>
      <QuestionLegend />
      <div class="rhead" aria-hidden="true">
        <span></span><span>Company</span><span>Flags, by question</span><span style="text-align: right">Total</span
        ><span style="text-align: right">Per page</span>
      </div>
      <ol class="rank">
        {
          top.map((c, i) => (
            <li>
              <a
                class="rrow"
                href={companyHref(c)}
                aria-label={`${c.company}: ${fmt(c.biasLoad)} red flags in total, ${perPage(c)} per page`}
              >
                <span class="r-no">{String(i + 1).padStart(2, "0")}</span>
                <span class="r-name">{c.company}</span>
                <FlagBar company={c} max={scale} />
                <span class="r-total">{fmt(c.biasLoad)}</span>
                <span class="r-per">
                  {perPage(c)}<span class="r-unit"> per page</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a class="more" href={href("/companies")}>All {fmt(all.length)} companies →</a>
    </section>

    <section class="wrap section" id="fair">
      <div class="fairbox">
        <div>
          <h2 class="display h2">Proof it’s possible</h2>
          <p>These companies stay fair: one red flag per page or fewer.</p>
          <div class="how">
            <b>What fair looks like</b>An honest review: it weighs the rival’s strengths and weaknesses, recommends
            what fits the reader’s needs, and backs every claim with facts.
          </div>
        </div>
        <div>
          <FairTable limit={10} />
          <a class="more" href={href("/companies")}>All {fmt(all.length)} companies →</a>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <h2 class="display h2">Volume against bias</h2>
        <p>
          Left to right: red flags per page. Bottom to top: compare pages, on a log scale. Bigger dots have more red flags
          in total. Green rings are fair players.
        </p>
      </div>
      <ScatterChart companies={scoredCompanies(all)} />
    </section>

    <section class="wrap section" id="made">
      <div class="made">
        <img
          src={mountain.src}
          width={mountain.width}
          height={mountain.height}
          loading="lazy"
          alt="A blue mountain in front of a huge pink and orange sun, with a small cabin among pine trees"
        />
        <div>
          <h2 class="display h2">Who made this</h2>
          <p>
            The Bias Index is made by Whimsical. We make a workspace for docs, boards and diagrams, so some of the
            companies here are our competitors.
          </p>
          <p>
            Most comparison pages are a game rigged in the author’s favor. We don’t publish any, and if we ever do,
            they’ll be fair, and scored here by the same rules as everyone else’s.
          </p>
          <p>
            You shouldn’t have to take our word for any of it, so everything is open: the scores, the code, and the
            labeled pages we test the scoring against.
          </p>
          <div class="links">
            <a href={href("/methodology")}>How the scoring works</a>
            <a href={`${REPO_URL}/releases/latest`}>Download the data</a>
            <a href={REPO_URL}>The code on GitHub</a>
            <a href={WHY_URL}>Why we built it</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Look a company up by its website: "https://www.Miro.com/app" goes to /miro.com, aliases included.
  const form = document.querySelector<HTMLFormElement>("form.lookup")
  const input = form?.querySelector("input")
  const note = form?.querySelector<HTMLElement>(".lookup-note")
  const domains: Record<string, string> = JSON.parse(form?.dataset.domains ?? "{}")
  form?.addEventListener("submit", event => {
    event.preventDefault()
    const domain = (input?.value ?? "")
      .trim()
      .toLowerCase()
      .replace(/^[a-z]+:\/\//, "")
      .replace(/[/?#:].*$/, "")
      .replace(/^www\./, "")
      .replace(/\.$/, "")
    if (!domain) return input?.focus()
    // A subdomain counts for its company (app.miro.com is Miro).
    const known = Object.keys(domains).find(d => domain === d || domain.endsWith(`.${d}`))
    if (known) {
      location.href = domains[known]
      return
    }
    if (!note) return
    const link = document.createElement("a")
    link.href = form?.action ?? "/companies"
    link.textContent = "See every company"
    note.replaceChildren(`We don’t track ${domain} yet. `, link, ".")
    note.hidden = false
  })
</script>

<style lang="scss" is:global>
  .hero {
    padding-top: 48px;
  }

  .kicker {
    margin: 0 0 20px;
    font-size: 14px;
  }

  .h1 {
    font-size: 96px;
    line-height: 0.96;
    margin: 0;
    max-width: 11.5ch;
  }

  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }

  .lede {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.6;
    max-width: 44ch;
  }

  .lookup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 12px 0 0;
  }

  .lookup label {
    font-size: 13px;
    color: #5f5a72;
  }

  .lookup-row {
    display: flex;
    gap: 8px;
  }

  .lookup input {
    flex: 1;
    min-width: 0;
    height: 52px;
    border: 1.5px solid #1a1630;
    border-radius: 10px;
    padding: 0 16px;
    font: inherit;
    font-size: 16px;
    color: #1a1630;
    background: #fff;
  }

  .btn {
    height: 52px;
    padding: 0 22px;
    border-radius: 10px;
    border: 0;
    background: #1a1630;
    color: #fff;
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 44px;
  }

  .example {
    margin: 0;
    border: 1px solid #e6e3ec;
    border-radius: 10px;
    padding: 22px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .example-k {
    font-size: 12px;
    color: #5f5a72;
  }

  .example-url {
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  a.example-url {
    text-decoration: none;
  }

  a.example-url:hover {
    text-decoration: underline;
  }

  .example ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
  }

  .example li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .example li b {
    font-weight: 700;
    font-size: 13px;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    display: block;
  }

  // An answer that isn't a red flag (the example is normally five out of five): a grey ring, as on company pages.
  .dot.off {
    background: #fff;
    box-shadow: inset 0 0 0 1.5px #d4d0dc;
  }

  .example-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #e6e3ec;
    padding-top: 12px;
    font-size: 13px;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 88px;
    border-top: 1px solid #1a1630;
  }

  .fact {
    padding: 20px 24px 0 0;
  }

  .fact b {
    display: block;
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 48px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .fact span {
    font-size: 13px;
    color: #5f5a72;
  }

  .section {
    padding-top: 136px;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

  .h2 {
    font-size: 56px;
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }

  .section-head p {
    margin: 0;
    max-width: 64ch;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 13px;
    margin-bottom: 20px;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend .dot {
    width: 12px;
    height: 12px;
  }

  .rank {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #1a1630;
  }

  .rhead {
    display: grid;
    grid-template-columns: 36px 170px minmax(0, 1fr) 96px 84px;
    gap: 20px;
    padding: 10px 0;
    font-size: 12px;
    color: #5f5a72;
    border-bottom: 1px solid #1a1630;
  }

  .rrow {
    display: grid;
    grid-template-columns: 36px 170px minmax(0, 1fr) 96px 84px;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #e6e3ec;
    text-decoration: none;
    color: inherit;
  }

  .rrow:hover .r-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .r-no {
    font-size: 13px;
    color: #5f5a72;
  }

  .r-name {
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .bar {
    position: relative;
    display: flex;
    height: 16px;
    border-radius: 3px;
    overflow: hidden;
    min-width: 3px;
  }

