    display: block;
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 48px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .fact span {
    font-size: 13px;
    color: #5f5a72;
    white-space: nowrap;
  }

  .section {
    padding-top: 136px;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

