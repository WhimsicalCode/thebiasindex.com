---
import mountain from "@/assets/images/land-mountain.jpg"
// Home page (design/v2/mockups/Main.dc.html), desktop and phone in one layout.
import FairTable from "@/components/fair-table.astro"
import FlagBar from "@/components/flag-bar.astro"
import QuestionLegend from "@/components/question-legend.astro"
import ScatterChart from "@/components/scatter-chart.astro"
import BaseLayout from "@/layouts/base-layout.astro"
import {
  byRedFlags,
  companies,
  companyHref,
  examplePage,
  latestRun,
  longDate,
  QUESTIONS,
  scoredCompanies,
} from "@/lib/db"
import { href } from "@/lib/deploy"
import { fmt, inkEnd, perPage, redFlags } from "@/lib/format"
import { siteDataset } from "@/lib/schema"
import { REPO_URL, WHY_URL } from "@/lib/site"

const all = companies()
const ranked = byRedFlags(all)
const top = ranked.slice(0, 10)
const scale = ranked[0]?.biasLoad ?? 1
const example = examplePage(all)
const run = latestRun()
const totalPages = all.reduce((sum, c) => sum + c.scoredPages, 0)
const totalFlags = all.reduce((sum, c) => sum + c.biasLoad, 0)
const facts = [
  { value: fmt(all.length), label: "Companies" },
  { value: fmt(totalPages), label: "Compare pages" },
  { value: fmt(totalFlags), label: "Red flags" },
]
const urlOf = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "")

// For the lookup: each company's name and every domain it is known by, pointing at its page.
const lookup = all
  .map(c => ({
    name: c.company,
    slug: c.slug,
    domains: [
      ...new Set([c.slug, ...c.aliases, ...c.hosts].map(domain => domain.replace(/^www\./, ""))),
    ],
    href: companyHref(c),
  }))
  .sort((a, b) => a.name.localeCompare(b.name))
---

<BaseLayout
  title="How fair are SaaS comparison pages? · The Bias Index"
  home
  alternates={[{ href: href("/companies.json"), type: "application/json", title: "Every company, as JSON" }]}
  jsonLd={siteDataset()}
>
  <main>
    <section class="wrap hero">
      <div class="hero-cols">
        <div>
          <p class="kicker muted">Read every week.{run && ` Last updated ${longDate(run.startedAt)}.`}</p>
          <h1 class="display h1">How fair are SaaS comparison pages?</h1>
          <p class="lede">
            On their own comparison pages, companies win every single time. Every week, we find them all and score
            each one for bias.
          </p>
        </div>

        <div class="hero-right" id="questions">
          {
            example && (
              <figure class="example">
                <figcaption class="example-k">A biased compare page</figcaption>
                <a class="example-url" href={example.url} rel="nofollow noopener">{urlOf(example.url)}</a>
                <ul>
                  {QUESTIONS.map((q, i) => (
                    <li>
                      <i class:list={["dot", { off: example.answers[i] !== "flag" }]} style={`background: ${q.color}`} />
                      <span>{q.label}</span>
                      <b>{example.answers[i] === "flag" ? "Flagged" : "Not flagged"}</b>
                    </li>
                  ))}
                </ul>
                <div class="example-total">
                  <span>{redFlags(example.score ?? 0)} out of {QUESTIONS.length}</span>
                  <span class="dots" aria-hidden="true">
                    {QUESTIONS.map((q, i) => (
                      <i class:list={["dot", { off: example.answers[i] !== "flag" }]} style={`background: ${q.color}`} />
                    ))}
                  </span>
                </div>
              </figure>
            )
          }
          <form
            class="lookup"
            action={href("/companies")}
            data-companies={JSON.stringify(lookup)}
          >
            <label for="domain">Look up a company by its name or website</label>
            <div class="lookup-row">
              <div class="lookup-field">
                <input
                  id="domain"
                  name="q"
                  type="text"
                  placeholder="miro.com"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="lookup-list"
                  autocomplete="off"
                  autocapitalize="none"
                  spellcheck="false"
                />
                <ul class="lookup-list" id="lookup-list" role="listbox" aria-label="Companies" hidden></ul>
              </div>
              <button class="btn" type="submit">Look up</button>
            </div>
          </form>
        </div>
      </div>

      <div class="facts">
        {
          facts.map(f => (
            <div class="fact">
              <b style={inkEnd(f.value, "Dinsical")}>{f.value}</b>
              <span style={inkEnd(f.label, "Monsical")}>{f.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <h2 class="display h2">Most red flags</h2>
        <p>Every red flag on every page, added up.</p>
      </div>
      <QuestionLegend />
      <div class="rhead" aria-hidden="true">
        <span></span><span>Company</span><span>Flags, by question</span><span style="text-align: right">Total</span
        ><span style="text-align: right">Per page</span>
      </div>
      <ol class="rank">
        {
          top.map((c, i) => (
            <li>
              <a
                class="rrow"
                href={companyHref(c)}
                aria-label={`${c.company}: ${fmt(c.biasLoad)} red flags in total, ${perPage(c)} per page`}
              >
                <span class="r-no">{String(i + 1).padStart(2, "0")}</span>
                <span class="r-name">{c.company}</span>
                <FlagBar company={c} max={scale} />
                <span class="r-total">{fmt(c.biasLoad)}</span>
                <span class="r-per">
                  {perPage(c)}<span class="r-unit"> per page</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a class="more" href={href("/companies")}>All {fmt(all.length)} companies →</a>
    </section>

    <section class="wrap section" id="fair">
      <div class="fairbox">
        <div>
          <h2 class="display h2">Proof it’s possible</h2>
          <p>These companies stay fair: one red flag per page or fewer.</p>
          <div class="how">
            <b>What fair looks like</b>An honest review: it weighs the rival’s strengths and weaknesses, recommends
            what fits the reader’s needs, and backs every claim with facts.
          </div>
        </div>
        <div>
          <FairTable limit={10} />
          <a class="more" href={href("/companies")}>All {fmt(all.length)} companies →</a>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <h2 class="display h2">Volume against bias</h2>
        <p>
          Left to right: red flags per page. Bottom to top: compare pages, on a log scale. Bigger dots have more red flags
          in total. Green rings are fair players.
        </p>
      </div>
      <ScatterChart companies={scoredCompanies(all)} />
    </section>

    <section class="wrap section" id="made">
      <div class="made">
        <img
          src={mountain.src}
          width={mountain.width}
          height={mountain.height}
          loading="lazy"
          alt="A blue mountain in front of a huge pink and orange sun, with a small cabin among pine trees"
        />
        <div>
          <h2 class="display h2">Who made this</h2>
          <p>
            The Bias Index is made by Whimsical. We make a workspace for docs, boards and diagrams, so some of the
            companies here are our competitors.
          </p>
          <p>
            Most comparison pages are a game rigged in the author’s favor. We don’t publish any, and if we ever do,
            they’ll be fair, and scored here by the same rules as everyone else’s.
          </p>
          <p>
            You shouldn’t have to take our word for any of it, so everything is open: the scores, the code, and the
            labeled pages we test the scoring against.
          </p>
          <div class="links">
            <a href={href("/methodology")}>How the scoring works</a>
            <a href={`${REPO_URL}/releases/latest`}>Download the data</a>
            <a href={REPO_URL}>The code on GitHub</a>
            <a href={WHY_URL}>Why we built it</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { addCompanyUrl, isDomain } from "@/lib/site"

  // Look a company up by name or website as you type: "mir", "Miro" and "https://www.Miro.com/app" all suggest Miro,
  // aliases included. When nothing matches, the only suggestion is to ask for the company in a GitHub issue.
  type Company = { name: string; slug: string; domains: string[]; href: string }
  type Option = { company: Company } | { add: string }

  const MAX_OPTIONS = 8
  const form = document.querySelector<HTMLFormElement>("form.lookup")
  const input = form?.querySelector("input")
  const list = form?.querySelector<HTMLUListElement>(".lookup-list")
  const companies: Company[] = JSON.parse(form?.dataset.companies ?? "[]")
  let options: Option[] = []
  let active = 0

  const domainOf = (text: string) =>
    text
      .trim()
      .toLowerCase()
      .replace(/^[a-z]+:\/\//, "")
      .replace(/[/?#:].*$/, "")
      .replace(/^www\./, "")
      .replace(/\.$/, "")

  // 0: the name or a domain starts with the query, or the query is on one of its domains (app.miro.com is Miro).
  // 1: a word of the name starts with it. 2: the name or a domain contains it. null: no match.
  function rank(company: Company, text: string, domain: string): number | null {
    const name = company.name.toLowerCase()
    const on = (d: string) => domain === d || domain.endsWith(`.${d}`)
    if (name.startsWith(text) || company.domains.some(d => d.startsWith(domain) || on(d))) return 0
    if (name.split(/[\s.-]+/).some(word => word.startsWith(text))) return 1
    if (name.includes(text) || company.domains.some(d => d.includes(domain))) return 2
    return null
  }

  function matches(query: string): Option[] {
    const text = query.trim().toLowerCase()
    const domain = domainOf(query)
    if (!text) return []
    const found = companies
      .map(company => ({ company, rank: rank(company, text, domain || text) }))
      .filter((match): match is { company: Company; rank: number } => match.rank !== null)
      .sort((a, b) => a.rank - b.rank)
      .slice(0, MAX_OPTIONS)
    // Ask for "acme.io" when given "https://acme.io/pricing", and for a name as typed.
    const add = isDomain(domain) ? domain : query.trim()
    return found.length ? found.map(({ company }) => ({ company })) : [{ add }]
  }

  function render() {
    if (!input || !list) return
    const open = options.length > 0
    list.hidden = !open
    input.setAttribute("aria-expanded", String(open))
    list.replaceChildren(
      ...options.map((option, i) => {
        const item = document.createElement("li")
        item.id = `lookup-option-${i}`
        item.setAttribute("role", "option")
        item.setAttribute("aria-selected", String(i === active))
        const main = document.createElement("span")
        const side = document.createElement("span")
        side.className = "lookup-side"
        if ("company" in option) {
          main.textContent = option.company.name
          side.textContent = option.company.slug
        } else {
          main.textContent = `Add “${option.add}”`
          side.textContent = "Ask on GitHub ↗"
        }
        item.append(main, side)
        // Keep the focus in the input, so the list doesn't close before the click.
        item.addEventListener("mousedown", event => event.preventDefault())
        item.addEventListener("mousemove", () => {
          if (active !== i) move(i)
        })
        item.addEventListener("click", () => choose(option))
        return item
      })
    )
    if (open) input.setAttribute("aria-activedescendant", `lookup-option-${active}`)
    else input.removeAttribute("aria-activedescendant")
  }

  function move(to: number) {
    active = (to + options.length) % options.length
    render()
    list?.children[active]?.scrollIntoView({ block: "nearest" })
  }

  function close() {
    options = []
    render()
  }

  function choose(option: Option | undefined) {
    if (!option) return input?.focus()
    if ("company" in option) {
      location.href = option.company.href
      return
    }
    window.open(addCompanyUrl(option.add), "_blank", "noopener")
    close()
  }

  input?.addEventListener("input", () => {
    options = matches(input.value)
    active = 0
    render()
  })
  input?.addEventListener("focus", () => {
    if (input.value.trim()) {
      options = matches(input.value)
      render()
    }
  })
  input?.addEventListener("blur", close)
  input?.addEventListener("keydown", event => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault()
      if (!options.length) options = matches(input.value)
      if (options.length) move(active + (event.key === "ArrowDown" ? 1 : -1))
    } else if (event.key === "Escape" && options.length) {
      event.preventDefault()
      close()
    }
  })
  // Enter or the button: the highlighted suggestion, the first one by default.
  form?.addEventListener("submit", event => {
    event.preventDefault()
    choose(options.length ? options[active] : matches(input?.value ?? "")[0])
  })
</script>

<style lang="scss" is:global>
  .hero {
    padding-top: 48px;
  }

  .kicker {
    margin: 0 0 20px;
    font-size: 14px;
  }

  // Shrinks with the page so "comparison" stays inside its column: 96px from about 1160px wide, 76px at 961px.
  .h1 {
    font-size: min(96px, 10cqi - 20px);
    line-height: 0.96;
    margin: 0;
    max-width: 11.5ch;
  }

  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }

  .lede {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.6;
    max-width: 44ch;
  }

  .lookup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 12px 0 0;
  }

  .lookup label {
    font-size: 13px;
    color: #5f5a72;
  }

  .lookup-row {
    display: flex;
    gap: 8px;
  }

  .lookup-field {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .lookup input {
    flex: 1;
    min-width: 0;
    height: 52px;
    border: 1.5px solid #1a1630;
    border-radius: 10px;
    padding: 0 16px;
    font: inherit;
    font-size: 16px;
    color: #1a1630;
    background: #fff;
  }

  // Suggestions as you type (not in the mockup).
  .lookup-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 10;
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 336px;
    overflow-y: auto;
    border: 1.5px solid #1a1630;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(26, 22, 48, 0.12);
  }

  .lookup-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 15px;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
  }

  .lookup-list li[aria-selected="true"] {
    background: #f4f2f8;
  }

  // On a narrow screen, the website gives way to the name.
  .lookup-side {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 13px;
    color: #5f5a72;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 44px;
  }

  .example {
    margin: 0;
    border: 1px solid #e6e3ec;
    border-radius: 10px;
    padding: 22px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .example-k {
    font-size: 12px;
    color: #5f5a72;
  }

  .example-url {
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  a.example-url {
    text-decoration: none;
  }

  a.example-url:hover {
    text-decoration: underline;
  }

  .example ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
  }

  .example li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .example li b {
    font-weight: 700;
    font-size: 13px;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    display: block;
  }

  // An answer that isn't a red flag (the example is normally five out of five): a grey ring, as on company pages.
  .dot.off {
    background: #fff;
    box-shadow: inset 0 0 0 1.5px #d4d0dc;
  }

