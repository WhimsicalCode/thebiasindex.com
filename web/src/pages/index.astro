    margin: 16px 0 0;
    max-width: 46ch;
  }

  .made {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 72px;
    align-items: center;
  }

  .made img {
    display: block;
    width: 100%;
    height: auto; // the width and height attributes only reserve the space
    border-radius: 6px;
  }

  .made p {
    max-width: 54ch;
    margin: 18px 0 0;
  }

  // Lookup result for a domain we don't track (not in the mockup).
  .lookup-note {
    margin: 0;
    font-size: 13px;
    color: #5f5a72;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 32px;
  }

  @container page (max-width: 760px) {
    .hero {
      padding-top: 20px;
    }

    .kicker {
      font-size: 13px;
      margin-bottom: 14px;
    }

    .h1 {
      font-size: 46px;
      line-height: 1;
    }

    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .lede {
      font-size: 15px;
      margin-top: 22px;
    }

    .lookup {
      margin-top: 4px;
    }

    .hero-right {
      padding-top: 0;
    }

    .example {
      padding-left: 18px;
      padding-right: 18px;
    }

    .example-url {
      font-size: 17px;
    }

    a.example-url {
    text-decoration: none;
  }

  a.example-url:hover {
    text-decoration: underline;
  }

  .example ul {
      font-size: 13px;
    }

    .facts {
      margin-top: 48px;
    }

    .fact {
      padding: 16px 12px 0 0;
    }

    .fact b {
      font-size: 28px;
    }

    .section {
      padding-top: 88px;
    }

