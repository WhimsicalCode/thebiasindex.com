    font-size: 56px;
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }

  .section-head p {
    margin: 0;
    max-width: 64ch;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 13px;
    margin-bottom: 20px;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend .dot {
    width: 12px;
    height: 12px;
  }

  .rank {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #1a1630;
  }

  .rhead {
    display: grid;
    grid-template-columns: 36px 170px minmax(0, 1fr) 96px 84px;
    gap: 20px;
    padding: 10px 0;
    font-size: 12px;
    color: #5f5a72;
    border-bottom: 1px solid #1a1630;
  }

  .rrow {
    display: grid;
    grid-template-columns: 36px 170px minmax(0, 1fr) 96px 84px;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #e6e3ec;
    text-decoration: none;
    color: inherit;
  }

  .rrow:hover .r-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .r-no {
    font-size: 13px;
    color: #5f5a72;
  }

  .r-name {
    font-family: "Dinsical", system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .bar {
    position: relative;
    display: flex;
    height: 16px;
    border-radius: 3px;
    overflow: hidden;
    min-width: 3px;
  }

  .bar i {
    display: block;
    height: 100%;
  }

  .r-total {
    font-family: "Monsical", ui-monospace, monospace;
    font-weight: 700;
    font-size: 20px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .r-per {
    font-size: 13px;
    color: #5f5a72;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .r-unit {
    display: none;
  }

  .more {
    display: inline-block;
    margin-top: 28px;
    font-size: 15px;
  }

  .fairbox {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 72px;
    align-items: start;
  }

  .fairbox p {
    margin: 16px 0 0;
    max-width: 46ch;
  }

  .made {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 72px;
    align-items: center;
  }

  .made img {
    display: block;
    width: 100%;
    height: auto; // the width and height attributes only reserve the space
    border-radius: 6px;
  }

  .made p {
    max-width: 54ch;
    margin: 18px 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 32px;
  }

  // Medium: too narrow for the heading and the example side by side, so they stack as on a phone.
  @container page (max-width: 960px) {
    .h1 {
      font-size: 80px;
    }

    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .hero-right {
      padding-top: 0;
      max-width: 560px;
    }
  }

  @container page (max-width: 760px) {
    .hero {
      padding-top: 20px;
    }

    .kicker {
      font-size: 13px;
      margin-bottom: 14px;
    }

    .h1 {
      font-size: 46px;
      line-height: 1;
    }

    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .lede {
      font-size: 15px;
      margin-top: 22px;
    }

    .lookup {
      margin-top: 4px;
    }

    .hero-right {
      padding-top: 0;
    }

    .example {
      padding-left: 18px;
      padding-right: 18px;
    }

    .example-url {
      font-size: 17px;
    }

    .example ul {
      font-size: 13px;
    }

    .facts {
      margin-top: 48px;
    }

    .fact {
      padding-top: 16px;
    }

    .fact b {
      font-size: 28px;
    }

    .section {
      padding-top: 88px;
    }

    .section-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      margin-bottom: 28px;
    }

    .h2 {
      font-size: 38px;
    }

    .rhead {
      display: none;
    }

    .rrow {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 8px 12px;
      padding: 14px 0;
    }

    .r-name {
      font-size: 18px;
    }

    .rrow .bar {
      grid-column: 2 / -1;
      grid-row: 2;
      height: 12px;
    }

